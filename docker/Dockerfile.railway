# Single service: ASP.NET Core API + Vite/React SPA in wwwroot (same origin → /api works without CORS setup).
# Build from repository root: docker build -f docker/Dockerfile.railway .

FROM node:20-alpine AS web
WORKDIR /src
COPY web/package*.json web/
RUN cd web && npm ci
COPY web/ web/
RUN cd web && npm run build

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY ["api/CoachSubscriptionApi.csproj", "api/"]
RUN dotnet restore api/CoachSubscriptionApi.csproj
COPY api/ api/
COPY --from=web /src/web/dist/ api/wwwroot/
WORKDIR /src/api
RUN dotnet publish -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app
COPY --from=build /app/publish .
EXPOSE 8080
ENTRYPOINT ["dotnet", "CoachSubscriptionApi.dll"]
